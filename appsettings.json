{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "SourceName": "WRMS.Agent",
      "LogName": "Application",
      "LogLevel": {
        "Default": "Warning",
        "WRMS.Agent": "Information"
      }
    }
  },
  "Agent": {
    "AgentName": "WRMS-Agent",
    "AgentVersion": "1.0.0",
    "PolicyCheckIntervalSeconds": 60,
    "TelemetryScanIntervalHours": 1,
    "EnablePocWebsiteBlocking": true,
    "EnablePocBrowserPolicy": true
  },
  "Backend": {
    "ApiBaseUrl": "https://wrms-backend-2m6u.onrender.com",
    "AgentApiKey": "wrms-agent-secret-key-2026",
    "UseRemotePolicy": true,
    "RequestTimeoutSeconds": 30
  }
}
